# Bridge server
PORT=3006

# Cashlogy
CASHLOGY_URL=http://127.0.0.1:3000
CASHLOGY_API_KEY=
# Optional: load the key from a local file instead of storing it here.
CASHLOGY_API_KEY_FILE=
CASHLOGY_MACHINE_CODE=hicream-pos
CASHLOGY_CHARGE_SCREEN_VISIBLE=false
CASHLOGY_CHARGE_TOP_MOST=false
CASHLOGY_POLL_INTERVAL_MS=500
CASHLOGY_INIT_TIMEOUT_MS=60000
CASHLOGY_CHARGE_TIMEOUT_MS=180000
CASHLOGY_OPERATION_TIMEOUT_MS=120000

# Comercia Global Payments / InStore Payment API (WECR Windows service)
COMERCIA_BASE_URL=https://127.0.0.1:3010/v1
COMERCIA_API_KEY=
COMERCIA_PAYMENT_APP=comercia
COMERCIA_DEVICE_ID=
COMERCIA_PRINT_RECEIPT=1
COMERCIA_TIMEOUT_MS=135000
COMERCIA_ALLOW_SELF_SIGNED=1

# Receipt printer — Mostrador (EPSON TM-m30 via Windows USB driver)
PRINTER_INTERFACE=windows
PRINTER_NAME=EPSON TM-m30 Receipt
PRINTER_CHARACTER_SET=PC858_EURO

# Kitchen printer — Cocina (POS-80C via network)
KITCHEN_PRINTER_HOST=192.168.1.143
KITCHEN_PRINTER_PORT=9100

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:3005,https://your-app.vercel.app

# Sync: PostgreSQL local → Neon (nube)
LOCAL_DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/hicream
# Cloud database used by the Vercel dashboard. Never point this at the local POS DB.
DASHBOARD_DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
# Auto uses Neon HTTPS for neon.tech URLs. Use pg only if port 5432 is allowed.
DASHBOARD_SYNC_DRIVER=auto
DASHBOARD_SYNC_TIMEZONE=Europe/Madrid
DASHBOARD_SYNC_DAY_INTERVAL_MS=1800000
DASHBOARD_SYNC_PEAK_INTERVAL_MS=300000
DASHBOARD_SYNC_NIGHT_CHECK_INTERVAL_MS=1800000
DASHBOARD_SYNC_BATCH_SIZE=500
