# Bridge server
PORT=3001

# Cashlogy
CASHLOGY_HOST=127.0.0.1
CASHLOGY_PORT=3999

# Ingenico (ZVT)
INGENICO_HOST=127.0.0.1
INGENICO_PORT=5577

# Printer
PRINTER_INTERFACE=tcp
PRINTER_HOST=127.0.0.1
PRINTER_PORT=9100

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Sync: PostgreSQL local → Neon (nube)
LOCAL_DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/hicream
NEON_DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
